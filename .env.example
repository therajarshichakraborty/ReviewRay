# ReviewRay environment variables. Copy to `.env` and fill in.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/reviewray"

# Better Auth + GitHub OAuth (sign in)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub App (reviews pull requests)
GITHUB_APP_ID=""
GITHUB_APP_NAME="reviewray"          # app slug, used in the install URL
GITHUB_APP_PRIVATE_KEY=""            # PEM, newlines escaped as \n
GITHUB_WEBHOOK_SECRET=""

# AI providers
# Free plan reviews run on OpenRouter. Pro plan reviews run on OpenAI.
# Until OPENAI_API_KEY is set, Pro reviews also fall back to OpenRouter,
# so you can turn OpenAI on later by adding the key here. No code changes.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemma-4-31b-it:free"
# Comma separated, tried in order when the primary is rate limited (max 2 used).
OPENROUTER_FALLBACK_MODELS="nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Background jobs
INNGEST_DEV="1"                      # local dev server; remove in production
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# Vector search (codebase context)
PINECONE_API_KEY=""
PINECONE_INDEX=""

# Billing (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_PLAN_ID=""
RAZORPAY_WEBHOOK_SECRET=""
# Public key id for the checkout window (safe to expose).
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
